
import numpy as np
import csv

# County and month names
counties = ["Nairobi", "Nakuru", "Kisumu", "Mombasa", "Machakos"]

months = [
    "January", "February", "March", "April",
    "May", "June", "July", "August",
    "September", "October", "November", "December"
]

# Rainfall data for the first four counties
clean_rows = [
    [64, 56, 92, 219, 176, 35, 18, 24, 31, 61, 165, 104],
    [35, 42, 70, 145, 120, 78, 96, 105, 72, 55, 60, 38],
    [58, 90, 150, 240, 180, 95, 70, 85, 90, 88, 130, 95],
    [30, 15, 55, 150, 240, 110, 90, 65, 60, 90, 100, 70]
]

# Raw Machakos data
machakos_raw = [
    "48", "35", "88", "N/A", "140", " 20 ",
    "9", "12", "", "45", "182", "96"
]

# Clean Machakos data
def clean_machakos(raw_values):
    values = []
    invalid_indices = []

    for i, value in enumerate(raw_values):
        try:
            values.append(int(value.strip()))
        except ValueError:
            values.append(None)
            invalid_indices.append(i)

    # Average only valid values, then round to integer
    valid_average = round(
        sum(v for v in values if v is not None)
        / sum(v is not None for v in values)
    )

    for i in invalid_indices:
        values[i] = valid_average

    return values, invalid_indices

machakos, imputed_indices = clean_machakos(machakos_raw)

print("Machakos cleaned rainfall:", machakos)
print("Imputed months:", [months[i] for i in imputed_indices])
print("Imputed value (mm):", machakos[imputed_indices[0]])

# Combine all counties into a NumPy array
R = np.array(clean_rows + [machakos])

print("Rainfall array:")
print(R)
print("Shape:", R.shape)
print("Data type:", R.dtype)

# Annual rainfall total per county
annual_totals = np.sum(R, axis=1)

# Average rainfall for each month across all counties
monthly_averages = np.mean(R, axis=0)

# Wettest month in each county
wettest_indices = np.argmax(R, axis=1)
wettest_months = [months[i] for i in wettest_indices]

# Count months with rainfall below 50 mm
dry_month_counts = np.sum(R < 50, axis=1)

# Highest-rainfall consecutive two-month planting window
two_month_totals = R[:, :-1] + R[:, 1:]
planting_indices = np.argmax(two_month_totals, axis=1)
planting_windows = [
    f"{months[i]}-{months[i + 1]}"
    for i in planting_indices
]

# Print results using zip()
print("\nANNUAL RAINFALL SUMMARY")
for county, total, wettest, dry, window in zip(
    counties, annual_totals, wettest_months,
    dry_month_counts, planting_windows
):
    print(
        f"{county}: total={total} mm, "
        f"wettest={wettest}, dry months={dry}, "
        f"planting window={window}"
    )

print("\nAVERAGE MONTHLY RAINFALL")
for month, average in zip(months, monthly_averages):
    print(f"{month}: {average:.2f} mm")
